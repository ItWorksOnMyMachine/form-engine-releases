# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/form_engine

# Webhook targets (e.g. n8n) are configured per form in the admin builder
# and stored in the form schema; no env vars are needed for them.

# ─── Email Sending ───────────────────────────────────────────────────────────
# Provider: smtp | ses | sendgrid | console (console = log only, for dev)
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Forms
# Optional; replies go to the sender when unset
EMAIL_REPLY_TO=

# SMTP (when EMAIL_PROVIDER=smtp)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# true = require TLS (implicit on port 465, STARTTLS on other ports)
EMAIL_SMTP_TLS=true

# AWS SES (when EMAIL_PROVIDER=ses)
EMAIL_SES_REGION=us-east-1
# Leave both empty on AWS to use the IAM role (needs ses:SendEmail on the identity)
EMAIL_SES_ACCESS_KEY=
EMAIL_SES_SECRET_KEY=

# SendGrid (when EMAIL_PROVIDER=sendgrid)
EMAIL_SENDGRID_API_KEY=

# ─── OIDC Authentication (Auth.js) ───────────────────────────────────────────
# Protects /admin, /dashboard, and their API routes.
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_OIDC_ISSUER=https://login.domain.com
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
# Public base URL; required behind a load balancer (see docs/DEPLOYMENT.md)
# AUTH_URL=https://forms.example.com

# Single-tenant deployments: add every signed-in user to this tenant (created on first sign-in)
# AUTH_JIT_TENANT_SLUG=
# AUTH_JIT_TENANT_NAME=
# OIDC prompt used by "Not you?" (select_account, or login for IdPs without an account picker)
# AUTH_SWITCH_ACCOUNT_PROMPT=select_account

# ─── Directory Provider ──────────────────────────────────────────────────────
# Controls which identity provider handles user/role management.
# See docs/AUTH_PROVIDERS.md for setup instructions per provider.
#
# Options: auth-engine (default), entra, okta, auth0
DIRECTORY_PROVIDER=auth-engine

# Entra (when DIRECTORY_PROVIDER=entra)
# AUTH_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# ENTRA_TENANT_ID=

# Okta (when DIRECTORY_PROVIDER=okta)
# OKTA_API_TOKEN=
# OKTA_ROLE_GROUP_PREFIX=forms-engine

# Auth0 (when DIRECTORY_PROVIDER=auth0)
# AUTH0_MGMT_CLIENT_ID=
# AUTH0_MGMT_CLIENT_SECRET=

# Allow self-signed certs for local dev OIDC server (remove in production)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ─── Public URLs, framing, CORS ──────────────────────────────────────────────
# Base URL used in invitation links (recommended in production)
# APP_BASE_URL=https://forms.example.com
# Origins allowed to frame /forms/{id}/embed (default: same origin only)
# EMBED_FRAME_ANCESTORS=https://www.example.com
# Origins allowed to call /api/submissions from browser JS (default: none)
# SUBMISSIONS_CORS_ORIGINS=

# ─── License ─────────────────────────────────────────────────────────────────
# Without a valid key the app works normally, but public forms show an
# "Unlicensed copy, for evaluation only" notice and /admin shows a banner.
# FORM_ENGINE_LICENSE_KEY=

# ─── Bot protection (forms with captcha: true) ───────────────────────────────
# HMAC secret for ALTCHA challenges; required for such forms to accept
# submissions (they fail closed without it). Generate: openssl rand -hex 32
# CAPTCHA_HMAC_SECRET=
# Challenges per IP per 10 minutes (default 300)
# RATE_LIMIT_CAPTCHA_CHALLENGES=300

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Proxies in front of the app; client IP is read that far from the right of X-Forwarded-For
# TRUSTED_PROXY_HOPS=1
# RATE_LIMIT_SUBMISSIONS_TOTAL=3000
# RATE_LIMIT_SUBMISSIONS_CREATE=100
# RATE_LIMIT_DISABLED=false

# ─── Webhooks ────────────────────────────────────────────────────────────────
# Internal hosts allowed despite resolving to private addresses (e.g. n8n)
# WEBHOOK_ALLOWED_HOSTS=n8n.internal.example.com

# ─── Integration API (M2M, used by n8n) ──────────────────────────────────────
# The integration API is disabled until M2M_AUDIENCE is set.
# M2M_AUDIENCE=api://forms-engine
# M2M_ISSUER=
# M2M_REQUIRED_SCOPE=forms.integration
# M2M_CLIENT_TENANTS={"n8n-client":["<tenant-uuid>"]}
